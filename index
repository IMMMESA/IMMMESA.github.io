<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>IEADAM - Campos Elíseos 2</title>

    <meta name="description"
        content="Assembleia de Deus IEADAM Campos Elíseos 2">

    <!-- GOOGLE FONTS -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- FONT AWESOME -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- CSS -->
    <link rel="stylesheet" href="css/style.css">

</head>

<body>

    <!-- HEADER -->

    <header id="header">

        <div class="logo">

            <h1>IEADAM</h1>

            <span>CAMPOS ELÍSEOS 2</span>

        </div>

        <!-- MENU MOBILE -->

        <div class="menu-mobile" id="menu-mobile">

            <div></div>
            <div></div>
            <div></div>

        </div>

        <!-- MENU -->

        <nav id="menu">

            <a href="#inicio">Início</a>

            <a href="#sobre">Sobre</a>

            <a href="#cultos">Cultos</a>

            <a href="#galeria">Galeria</a>

            <a href="#redes">Redes</a>

        </nav>

    </header>

    <!-- HERO -->

    <section class="hero" id="inicio">

        <div class="hero-content">

            <span class="tag">
                Bem-vindo à Casa do Senhor
            </span>

            <h2>
                Assembleia de Deus
                Campos Elíseos 2
            </h2>

            <p>
                Um lugar preparado por Deus para restaurar vidas,
                fortalecer famílias e anunciar o evangelho de Cristo.
            </p>

            <div class="hero-buttons">

                <a href="#cultos" class="btn">
                    Horários dos Cultos
                </a>

                <a href="#sobre" class="btn-outline">
                    Conhecer Igreja
                </a>

            </div>

        </div>

    </section>

    <!-- SOBRE -->

    <section class="sobre" id="sobre">

        <div class="sobre-img">

            <img src="img/pastores.png"
                alt="Pastores">

        </div>

        <div class="sobre-text">

            <div class="title">

                <span>SOBRE NÓS</span>

                <h2>
                    Uma igreja comprometida com a Palavra de Deus
                </h2>

            </div>

            <p>
                A IEADAM Campos Elíseos 2 tem como missão proclamar o evangelho
                de Jesus Cristo, promovendo comunhão, discipulado e adoração.
            </p>

            <p>
                Somos uma igreja acolhedora, fundamentada na Bíblia Sagrada
                e guiada pelo Espírito Santo.
            </p>

        </div>

    </section>

    <!-- CULTOS -->

    <section id="cultos">

        <div class="title">

            <span>PROGRAMAÇÕES</span>

            <h2>Horários dos Cultos</h2>

        </div>

        <div class="cards">

            <div class="card">

                <i class="fas fa-church"></i>

                <h3>Domingo</h3>

                <p>Culto de Celebração</p>

                <strong>18h às 21h</strong>

            </div>

            <div class="card">

                <i class="fas fa-book-bible"></i>

                <h3>Terça-feira</h3>

                <p>Culto de Doutrina</p>

                <strong>19h30 às 21h</strong>

            </div>

            <div class="card">

                <i class="fas fa-praying-hands"></i>

                <h3>Sexta-feira</h3>

                <p>Hora Nona</p>

                <strong>15h às 16h</strong>

            </div>

        </div>

    </section>

    <!-- FRASE -->

    <section class="frase">

        <h2>
            “Eu e a minha casa serviremos ao Senhor.”
        </h2>

    </section>

    <!-- GALERIA -->

    <section id="galeria">

        <div class="title">

            <span>GALERIA</span>

            <h2>Nossa Igreja</h2>

        </div>

        <div class="galeria-grid">

            <img src="img/igrejaCampos2.png"
                alt="Igreja">

            <img src="img/pastores.png"
                alt="Pastores">

            <img src="img/EBD.jpg"
                alt="Escola Bíblica">

        </div>

    </section>

    <!-- REDES -->

    <section id="redes">

        <div class="title">

            <span>ACOMPANHE</span>

            <h2>Nossas Redes Sociais</h2>

        </div>

        <div class="social">

            <a href="https://facebook.com" target="_blank">
                <i class="fab fa-facebook-f"></i>
            </a>

            <a href="https://youtube.com" target="_blank">
                <i class="fab fa-youtube"></i>
            </a>

            <a href="https://instagram.com" target="_blank">
                <i class="fab fa-instagram"></i>
            </a>

        </div>

    </section>

    <!-- FOOTER -->

    <footer>

        <p>
            © 2026 IEADAM - Campos Elíseos 2.
            Todos os direitos reservados.
        </p>

    </footer>

    <!-- WHATSAPP -->

    <a href="https://wa.me/559299999999"
        class="whatsapp"
        target="_blank">

        <i class="fab fa-whatsapp"></i>

    </a>

    <!-- JAVASCRIPT -->
    <script src="js/script.js"></script>

</body>

</html>
